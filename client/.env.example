# Copy to .env (or .env.local) and adjust as needed. Values here are the
# defaults already baked into the app, so an empty/missing .env works fine.

# Port Vite's dev server runs on.
CLIENT_PORT=5173

# Port of the API server this client proxies /api requests to.
# Must match the server's own API_PORT (see server/.env.example).
API_PORT=4310
