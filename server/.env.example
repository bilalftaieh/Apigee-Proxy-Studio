# Copy to .env and adjust as needed. Values here are the defaults already
# baked into the app, so an empty/missing .env works fine out of the box.

# Port the API server listens on.
#
# Deliberately named API_PORT rather than the generic PORT: many editors,
# process launchers and deploy platforms inject their own PORT env var for
# whatever process THEY consider "the" server, which can silently collide
# with this one (e.g. you end up with two servers both trying to bind the
# same port, one of them winning invisibly). Scoping the name to this app
# avoids that class of bug entirely.
API_PORT=4310
