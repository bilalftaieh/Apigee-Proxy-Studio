# Copy to .env and fill in what you need. Every value here is optional — the
# defaults in code are what `npm run dev`, `npm start` and Studio.cmd already
# use, so an empty or missing .env works fine out of the box.
#
# THIS IS THE ONLY .env THE APP READS. It has to live here, at the repo root,
# next to this file. The server loads it via `dotenv/config`, which resolves
# `.env` against the working directory, and every way of starting the app runs
# from the root — Studio.cmd sets -WorkingDirectory there, and the npm scripts
# inherit it. Vite reads the same file for CLIENT_PORT and API_PORT. A
# server/.env or client/.env is silently ignored; earlier versions of this repo
# shipped examples suggesting otherwise, which is why this note exists.
#
# PRECEDENCE: an environment variable already set in your shell wins over the
# value here — that is dotenv's behaviour, and scripts/studio.ps1 matches it —
# so `$env:API_PORT=9999; .\Studio.cmd` is a one-off override that works, and
# this file is where the permanent choice lives.
#
# .env is gitignored; this file is the checked-in template.

# --- Ports / host ---------------------------------------------------------

# Port the API server listens on — and, once the UI is built, the port the
# whole app is served from.
#
# Deliberately named API_PORT rather than the generic PORT: many editors,
# process launchers and deploy platforms inject their own PORT env var for
# whatever process THEY consider "the" server, which can silently collide with
# this one (you end up with two servers trying to bind the same port, one of
# them winning invisibly). Scoping the name to this app avoids that class of
# bug. PORT is still honoured as a fallback for platforms that only set that.
API_PORT=4310

# Port Vite's dev server runs on (`npm run dev` only). It proxies /api and /vs
# to API_PORT, so the two must agree.
CLIENT_PORT=5173

# Bind address. Defaults to 127.0.0.1, which keeps this unauthenticated local
# API off your network — it writes files and spawns the apigeelint subprocess,
# so it must not be reachable from the LAN. Set 0.0.0.0 ONLY inside a
# container, where the published port is the boundary instead.
# API_HOST=127.0.0.1

# --- Storage --------------------------------------------------------------

# Where proxies, shared flows, templates and history are stored. Defaults to
# server/data. Set it to point the app at a different workspace directory —
# the test suite uses it to run against a temporary one, and it is what you
# would point at a mounted volume when running in a container.
# APIGEE_STUDIO_DATA_DIR=

# --- AI policy generator (optional) ---------------------------------------
#
# Leave unset and the AI features simply don't appear — everything else in the
# app works exactly as before.
#
# Get a key from https://aistudio.google.com/apikey (no credit card needed).
#
# PRIVACY: on Google's FREE tier, prompts may be used to improve their models
# and may be read by human reviewers. The PAID tier contractually excludes
# both. Enabling billing on the Google Cloud project behind this key is a
# settings change, not a code change — nothing here needs to be edited. For
# this app's usage, expect cents per month.
#
# Independently of the tier, this app never sends your proxy's hostnames,
# target URLs, KVM names, basepath or existing policy XML: the prompt is built
# from an explicit allowlist (server/src/lib/ai/safeContext.js), sensitive
# literals are swapped for placeholders (redact.js), and an outbound guard
# blocks the request if anything slips through (guard.js). Run `npm run test:ai`
# to verify that for yourself.
#
# Per-workspace opt-out: set "aiDisabled": true on a proxy to remove the
# feature for that proxy entirely, enforced server-side.
GEMINI_API_KEY=

# Override the model. The default is gemini-3.6-flash.
#
# This is the PERMANENT choice. The app can also switch models while it is
# running — there is a model chip beside every AI action, and a 503 offers a
# lighter model as a one-click retry — but that override lives in the server
# process and is gone when it restarts, at which point this file is what
# applies again. Set it here to make a choice stick.
#
# The chip's menu is not a hardcoded list: it asks your key what it can reach
# and shows the general-purpose Gemini text models among them, so a model
# released after this app was written is there without an update. Floating
# aliases (gemini-flash-latest and friends) are deliberately left out, for the
# reason in the paragraph above about pinning.
#
# Google retires model names periodically — gemini-2.5-flash began returning
# 404 "no longer available to new users". When that happens, the error shown in
# the app names the replacement Google recommends: switch to it from the chip
# to keep working, and put it here so it survives the next restart.
#
# The congestion case is what the in-app switch is really for. A 503 "high
# demand" on the default model is common at peak times; the app retries once on
# its own before telling you, and a lighter model usually still has capacity.
# GEMINI_MODEL=gemini-3.6-flash
# GEMINI_MODEL=gemini-3.1-flash-lite

# --- Launcher -------------------------------------------------------------

# Set to 1 by Studio.cmd when it runs a rebuild watcher alongside the server:
# it adds a reload poller to the served index.html so a page you already have
# open picks up a rebuild. No reason to set this by hand.
# STUDIO_WATCH=

# --- Logging --------------------------------------------------------------
#
# Everything below is optional; the defaults are what the app runs with.
#
# There are TWO levels on purpose. The terminal shows LOG_LEVEL so it stays
# readable while you work, and the file plus the in-app viewer keep
# LOG_FILE_LEVEL so the detail you need when something breaks was already being
# recorded before it broke. File writes are batched and off the request path,
# so the verbose one is also the cheap one.
#
# Levels: trace | debug | info | warn | error | fatal | silent
# LOG_LEVEL=info
# LOG_FILE_LEVEL=debug

# Where the log file goes. Defaults to server/logs/studio.log, rotated at
# LOG_MAX_BYTES into studio.log.1 … studio.log.N.
# LOG_DIR=
# LOG_MAX_BYTES=5242880
# LOG_MAX_FILES=5

# Turn a sink off entirely. The in-app log panel keeps working either way — it
# reads an in-memory ring, not the file.
# LOG_TO_FILE=true
# LOG_TO_CONSOLE=true
#
# Studio.cmd forces LOG_TO_CONSOLE off for the server it starts: nothing reads
# that process's stdout, and the redirect it lands in has none of studio.log's
# rotation, so leaving it on grew an unbounded second copy of the same lines.

# Coloured single lines vs raw NDJSON on stdout. Defaults to colour when stdout
# is a terminal and NDJSON when it is piped, which is usually what you want.
# LOG_PRETTY=

# How many records the in-app viewer can scroll back through, and the threshold
# above which a successful request is still logged as a warning because it took
# too long.
# LOG_RING_SIZE=2000
# LOG_SLOW_MS=1500

# Both levels can also be changed while the server is running — from the log
# panel in the app (Ctrl+`), or:
#   curl -X POST localhost:4310/api/logs/level -H 'Content-Type: application/json' -d '{"fileLevel":"trace"}'
